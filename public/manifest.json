{
  "manifest_version": 3,
  "name": "Bet-ter Judol Detector",
  "version": "1.0.0",
  "description": "Detects online gambling content using pattern matching algorithms.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "keywords/keyword.txt"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
